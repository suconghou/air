{
	"name": "air",
	"version": "0.8.0",
	"description": "static site server with on-the-fly less/js compile and ssi",
	"scripts": {
		"build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node18 --banner:js='#!/usr/bin/env node' --outfile=air && chmod +x air",
		"check": "tsc --noEmit"
	},
	"dependencies": {
		"less": "^4.2.0",
		"less-plugin-autoprefix": "^2.0.0",
		"terser": "^5.21.0"
	},
	"devDependencies": {
		"@types/node": "^20.8.4",
		"esbuild": "^0.25.0",
		"typescript": "^5.2.2"
	}
}
